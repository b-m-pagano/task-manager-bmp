{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hjkcuaqpucrxumpmuejk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "meu-task-manager",
      "version": "0.1.0",
      "title": "Meu Task Manager"
    },
    "tools": [
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List the signed-in user's tasks, optionally filtered by day or status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "day": {
              "description": "Scheduled day YYYY-MM-DD.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "done",
                "skipped"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_task_to_inbox",
        "title": "Add task to inbox",
        "description": "Capture a new task in the signed-in user's inbox to be scheduled later.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "estimated_minutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 720
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "set_task_status",
        "title": "Set task status",
        "description": "Change the status of one of the signed-in user's tasks (e.g. mark as done).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "done",
                "skipped"
              ]
            }
          },
          "required": [
            "task_id",
            "status"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
