{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hjkcuaqpucrxumpmuejk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "meu-task-manager",
      "version": "0.4.0",
      "title": "Meu Task Manager"
    },
    "tools": [
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List the signed-in user's tasks, optionally filtered by day or status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "day": {
              "description": "Scheduled day YYYY-MM-DD.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "done",
                "skipped"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_task_to_inbox",
        "title": "Add task to inbox",
        "description": "Capture one task in the user's inbox, optionally with its origin tool and a link to the original item.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short actionable task title."
            },
            "description": {
              "description": "One-line summary of what needs to be done.",
              "type": "string",
              "maxLength": 500
            },
            "notes": {
              "description": "Context: sender, relevant excerpt, deadline mentioned.",
              "type": "string",
              "maxLength": 4000
            },
            "estimated_minutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 720
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            "source": {
              "description": "Origin tool, e.g. gmail, slack, notion, github.",
              "type": "string",
              "maxLength": 30
            },
            "source_url": {
              "description": "Direct link to the original email/message/page.",
              "type": "string",
              "maxLength": 2000,
              "format": "uri"
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "import_to_inbox",
        "title": "Import items to inbox",
        "description": "Batch-import up to 25 action items gathered from other tools (emails, chat messages, docs) into the user's inbox. Skips items whose source_url is already in the inbox.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "items": {
              "minItems": 1,
              "maxItems": 25,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Short actionable task title."
                  },
                  "description": {
                    "description": "One-line summary of what needs to be done.",
                    "type": "string",
                    "maxLength": 500
                  },
                  "notes": {
                    "description": "Context: sender, relevant excerpt, deadline mentioned.",
                    "type": "string",
                    "maxLength": 4000
                  },
                  "estimated_minutes": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 720
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "urgent"
                    ]
                  },
                  "source": {
                    "description": "Origin tool, e.g. gmail, slack, notion, github.",
                    "type": "string",
                    "maxLength": 30
                  },
                  "source_url": {
                    "description": "Direct link to the original email/message/page.",
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "set_task_status",
        "title": "Set task status",
        "description": "Change the status of one of the signed-in user's tasks (e.g. mark as done).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "done",
                "skipped"
              ]
            }
          },
          "required": [
            "task_id",
            "status"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "decompose_task",
        "title": "Decompose task into micro-steps",
        "description": "Break an existing task into small ordered subtasks (5–25 min each) to reduce overwhelm and procrastination.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID of the parent task (use list_tasks to find it)."
            },
            "steps": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Concrete, action-first micro-step."
                  },
                  "estimated_minutes": {
                    "description": "Minutes for this step (5–25). Defaults to 15.",
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 25
                  }
                },
                "required": [
                  "title"
                ]
              },
              "description": "Ordered list of micro-steps, first step should be trivially easy to start."
            }
          },
          "required": [
            "task_id",
            "steps"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_task_with_subtasks",
        "title": "Create task with micro-steps",
        "description": "Create a new task together with an ordered checklist of small subtasks; goes to the inbox unless a day is given.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "steps": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Concrete, action-first micro-step."
                  },
                  "estimated_minutes": {
                    "description": "Minutes for this step (5–25). Defaults to 15.",
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 25
                  }
                },
                "required": [
                  "title"
                ]
              },
              "description": "Ordered list of micro-steps, first step should be trivially easy to start."
            },
            "day": {
              "description": "Scheduled day YYYY-MM-DD. Omit to capture in the inbox.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            }
          },
          "required": [
            "title",
            "steps"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_subtasks",
        "title": "List subtasks",
        "description": "List the micro-steps of a task with their progress.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "task_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_day_schedule",
        "title": "Get day schedule",
        "description": "Read one day's tasks plus Google Calendar events (events are fixed and must never be overlapped).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "day": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Day YYYY-MM-DD"
            },
            "tz_offset_minutes": {
              "description": "User UTC offset in minutes (São Paulo = -180). Defaults to -180.",
              "type": "integer",
              "minimum": -720,
              "maximum": 840
            }
          },
          "required": [
            "day"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "schedule_task",
        "title": "Schedule task",
        "description": "Move a task to a day and optionally a start time.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "day": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Day YYYY-MM-DD"
            },
            "start_time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$",
              "description": "Local time HH:MM"
            },
            "tz_offset_minutes": {
              "description": "User UTC offset in minutes (São Paulo = -180). Defaults to -180.",
              "type": "integer",
              "minimum": -720,
              "maximum": 840
            }
          },
          "required": [
            "task_id",
            "day"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "replan_day",
        "title": "Replan rest of day",
        "description": "Reorganize the rest of a day and save it. You decide order, priority, durations, done/tomorrow and new items; the app computes start times so nothing overlaps Google Calendar events. Call get_day_schedule first.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "day": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Day YYYY-MM-DD"
            },
            "now_time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$",
              "description": "Current local time; only the time after it is replanned."
            },
            "instruction": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "IDs of existing pending tasks in the desired new order (most important first)."
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "taskId": {
                        "type": "string"
                      },
                      "priority": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "low",
                              "medium",
                              "high",
                              "urgent"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "durationMin": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 5,
                            "maximum": 720
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "New duration, e.g. longer when running late."
                      },
                      "markDone": {
                        "type": "boolean"
                      },
                      "moveToTomorrow": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "taskId",
                      "priority",
                      "durationMin",
                      "markDone",
                      "moveToTomorrow"
                    ]
                  },
                  "description": "Only tasks that change; null fields = unchanged."
                },
                "newItems": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "durationMin": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 720
                      },
                      "priority": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          "urgent"
                        ]
                      },
                      "fixedStartMinute": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1439
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Minutes since 00:00 for a fixed-time appointment, else null."
                      }
                    },
                    "required": [
                      "title",
                      "durationMin",
                      "priority",
                      "fixedStartMinute"
                    ]
                  }
                }
              },
              "required": [
                "order",
                "changes",
                "newItems"
              ]
            },
            "tz_offset_minutes": {
              "description": "User UTC offset in minutes (São Paulo = -180). Defaults to -180.",
              "type": "integer",
              "minimum": -720,
              "maximum": 840
            }
          },
          "required": [
            "day",
            "now_time",
            "instruction"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
